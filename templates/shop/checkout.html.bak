{% extends 'base.html' %}

{% block title %}EEury - Checkout{% endblock %}

{% block content %}
<section class="checkout-bg">
  <div class="checkout-card">
    <div class="checkout-header">
      <a href="/" style="color: var(--primary); font-size: 2em; font-weight: bold; text-decoration: none;">EEURY</a>
      <h1 style="font-size: 1.5em; color: var(--text); margin-top: 5px;">Finalize Order</h1>
    </div>

    <div class="summary-block">
      <h3 style="color: var(--text); font-size: 1.2em; margin-bottom: 15px;">Your Order Details</h3>
      <div class="summary-item">
        <span>Subtotal ({{ item_count }} items)</span>
        <span>{{ subtotal }}</span>
      </div>
      <div class="summary-item">
        <span id="shipping-cost-label">Shipping (Standard)</span>
        <span id="shipping-cost-value" style="font-weight: bold;">{{ shipping_initial }}</span>
      </div>
      <div class="summary-item">
        <span>Tax Estimate (7%)</span>
        <span>{{ tax }}</span>
      </div>
      <div class="summary-item summary-total">
        <span style="font-weight: bold; color: var(--primary);">Total Amount</span>
        <span id="total-amount" style="font-weight: bold; color: var(--primary);">{{ total }}</span>
      </div>
    </div>

    <h3 style="color: var(--text); font-size: 1.2em; margin-bottom: 15px;">How would you like to receive your order?
    </h3>
    <div class="delivery-options">
      <div id="delivery-btn" class="delivery-option-btn active" onclick="selectDelivery('delivery')">
        <i class="fas fa-truck"></i> Delivery
      </div>
      <div id="pickup-btn" class="delivery-option-btn" onclick="selectDelivery('pickup')">
        <i class="fas fa-store"></i> Pick Up in Shop
      </div>
    </div>

    <div id="delivery-details" class="delivery-fields">
      <input type="email" placeholder="Email Address" required>
      <input type="text" placeholder="Shipping Address (Street, City, Zip)" required>
      <input type="tel" placeholder="Contact Phone Number" required>
    </div>

    <div id="pickup-details" class="delivery-fields" style="display: none;">
      <p style="font-style: italic; color: var(--primary); margin-bottom: 10px;">
        <i class="fas fa-map-marker-alt"></i> Your order will be ready at:<br>
        Eeury Flagship, 123 Green St, Metropolis, 10001
      </p>
      <input type="email" placeholder="Email Address for Notification" required>
      <input type="tel" placeholder="Contact Phone Number" required>
    </div>

    <h3 style="color: var(--text); font-size: 1.2em; margin-bottom: 15px;">Payment Details</h3>
    <input type="text" placeholder="Card Number" required>
    <div class="flex-group">
      <div class="grid-group">
        <input type="text" placeholder="MM / YY" required>
        <input type="text" placeholder="CVC" required>
      </div>
    </div>
    <p class="security-lock"><i class="fas fa-lock"></i> Secure Payment</p>

    <button class="green-button">Place Order ({{ total }})</button>
  </div>
  {% extends 'base.html' %}

  {% block title %}EEury - Checkout{% endblock %}

  {% block content %}
  <section class="checkout-bg">
    <div class="checkout-card">
      <div class="checkout-header">
        <a href="/" style="color: var(--primary); font-size: 2em; font-weight: bold; text-decoration: none;">EEURY</a>
        <h1 style="font-size: 1.5em; color: var(--text); margin-top: 5px;">Finalize Order</h1>
      </div>

      <div class="summary-block">
        <h3 style="color: var(--text); font-size: 1.2em; margin-bottom: 15px;">Your Order Details</h3>
        <div class="summary-item">
          <span>Subtotal ({{ item_count }} items)</span>
          <span>{{ subtotal }}</span>
        </div>
        <div class="summary-item">
          <span id="shipping-cost-label">Shipping (Standard)</span>
          <span id="shipping-cost-value" style="font-weight: bold;">{{ shipping_initial }}</span>
        </div>
        <div class="summary-item">
          <span>Tax Estimate (7%)</span>
          <span>{{ tax }}</span>
        </div>
        <div class="summary-item summary-total">
          <span style="font-weight: bold; color: var(--primary);">Total Amount</span>
          <span id="total-amount" style="font-weight: bold; color: var(--primary);">{{ total }}</span>
        </div>
      </div>

      <h3 style="color: var(--text); font-size: 1.2em; margin-bottom: 15px;">How would you like to receive your order?
      </h3>
      <div class="delivery-options">
        <div id="delivery-btn" class="delivery-option-btn active" onclick="selectDelivery('delivery')">
          <i class="fas fa-truck"></i> Delivery
        </div>
        <div id="pickup-btn" class="delivery-option-btn" onclick="selectDelivery('pickup')">
          <i class="fas fa-store"></i> Pick Up in Shop
        </div>
      </div>

      <div id="delivery-details" class="delivery-fields">
        <input type="email" placeholder="Email Address" required>
        <input type="text" placeholder="Shipping Address (Street, City, Zip)" required>
        <input type="tel" placeholder="Contact Phone Number" required>
      </div>

      <div id="pickup-details" class="delivery-fields" style="display: none;">
        <p style="font-style: italic; color: var(--primary); margin-bottom: 10px;">
          <i class="fas fa-map-marker-alt"></i> Your order will be ready at:<br>
          Eeury Flagship, 123 Green St, Metropolis, 10001
        </p>
        <input type="email" placeholder="Email Address for Notification" required>
        <input type="tel" placeholder="Contact Phone Number" required>
      </div>

      <h3 style="color: var(--text); font-size: 1.2em; margin-bottom: 15px;">Payment Details</h3>
      <input type="text" placeholder="Card Number" required>
      <div class="flex-group">
        <div class="grid-group">
          <input type="text" placeholder="MM / YY" required>
          <input type="text" placeholder="CVC" required>
        </div>
      </div>
      <p class="security-lock"><i class="fas fa-lock"></i> Secure Payment</p>

      <button class="green-button">Place Order ({{ total }})</button>
    </div>
  </section>

  <script>
    // Pass cart data to JavaScript
    window.cartItems = [
      {% for item in items %}
    {
      name: "{{ item.product.name|escapejs }}",
        quantity: { { item.quantity } },
      price: "{{ item.product.price }}",
        lineTotal: "{{ item.line_total }}"
    } {% if not forloop.last %}, {% endif %}
    {% endfor %}
  ];
  </script>
  <script src="{% static 'js/checkout.js' %}"></script>
  {% endblock %}
